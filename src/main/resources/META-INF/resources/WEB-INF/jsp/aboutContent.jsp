<%@ page contentType="text/html;charset=UTF-8" %>

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Description</h3>
            </div>
            <div class="card-body">
                <p>${description}</p>
                <p>Cette application permet de gérer l'ensemble des opérations d'un cinéma, de la programmation des films à la gestion des réservations en passant par l'administration des salles.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title">Technologies utilisées</h3>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li><i class="fas fa-check-circle text-success"></i> Spring Boot 4.0.1</li>
                    <li><i class="fas fa-check-circle text-success"></i> Spring MVC</li>
                    <li><i class="fas fa-check-circle text-success"></i> JSP</li>
                    <li><i class="fas fa-check-circle text-success"></i> AdminLTE 3.2</li>
                    <li><i class="fas fa-check-circle text-success"></i> PostgreSQL</li>
                    <li><i class="fas fa-check-circle text-success"></i> Java 17</li>
                    <li><i class="fas fa-check-circle text-success"></i> Bootstrap 4</li>
                    <li><i class="fas fa-check-circle text-success"></i> Font Awesome 6</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title">Fonctionnalités</h3>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li><i class="fas fa-film text-info"></i> Gestion des films</li>
                    <li><i class="fas fa-calendar text-info"></i> Planification des séances</li>
                    <li><i class="fas fa-ticket-alt text-info"></i> Réservations en ligne</li>
                    <li><i class="fas fa-door-open text-info"></i> Gestion des salles</li>
                    <li><i class="fas fa-chart-line text-info"></i> Statistiques détaillées</li>
                    <li><i class="fas fa-users text-info"></i> Gestion des clients</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Contact</h3>
            </div>
            <div class="card-body">
                <p><i class="fas fa-envelope"></i> Email: contact@gestion-cinema.mg</p>
                <p><i class="fas fa-phone"></i> Téléphone: +261 XX XX XXX XX</p>
                <p><i class="fas fa-map-marker-alt"></i> Adresse: ITU, Antananarivo, Madagascar</p>
            </div>
        </div>
    </div>
</div>
